{
  "name": "nutrition-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "config:validate": "expo config --type public",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": "^55.0.28",
    "expo-crypto": "~55.0.17",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.22",
    "react": "^19.2.0",
    "react-hook-form": "^7.0.0",
    "react-native": "^0.83.10",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.0.0",
    "babel-preset-expo": "~55.0.8",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^expo/virtual/env$": "<rootDir>/config/jestExpoEnv.js"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/config/jestReactNativeCompat.cjs"
    ]
  }
}
