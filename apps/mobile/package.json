{
  "name": "nutrition-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "config:validate": "expo config --type public",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^7.3.14",
    "@tanstack/react-query": "^5.101.4",
    "expo": "^57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "react": "19.2.8",
    "react-hook-form": "^7.83.0",
    "react-native": "0.86.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^30.4.2",
    "react-test-renderer": "^19.2.8",
    "typescript": "~7.0.2"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^expo/virtual/env$": "<rootDir>/config/jestExpoEnv.js"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
