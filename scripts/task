#!/usr/bin/env bash
set -euo pipefail

ROOT="$(
    cd "$(dirname "${BASH_SOURCE[0]}")/.."
    pwd
)"
EXPECTED_PYTHON_LINE="$(cat "$ROOT/.python-version")"

python_matches_project() {
    local candidate="$1"

    [[ -x "$candidate" ]] \
        || command -v "$candidate" >/dev/null 2>&1 \
        || return 1

    "$candidate" -c '
import sys
raise SystemExit(
    0
    if sys.version_info[:2] == tuple(map(int, sys.argv[1].split(".")))
    else 1
)
' "$EXPECTED_PYTHON_LINE" >/dev/null 2>&1
}

choose_python() {
    if command -v python3 >/dev/null 2>&1 \
        && python_matches_project "$(command -v python3)"; then
        command -v python3
        return 0
    fi

    if command -v "python$EXPECTED_PYTHON_LINE" >/dev/null 2>&1 \
        && python_matches_project "$(command -v "python$EXPECTED_PYTHON_LINE")"; then
        command -v "python$EXPECTED_PYTHON_LINE"
        return 0
    fi

    return 1
}

PROJECT_PYTHON="$(
    choose_python || true
)"

if [[ -z "$PROJECT_PYTHON" ]]; then
    echo "Unable to locate trusted Python $EXPECTED_PYTHON_LINE on PATH; install or select the project toolchain before running task." >&2
    exit 1
fi

exec \
    "$PROJECT_PYTHON" \
    "$ROOT/scripts/task.py" \
    "$@"
