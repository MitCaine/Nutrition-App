#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NODE_LINE=$(cat "$ROOT/.nvmrc")
PYTHON_LINE=$(cat "$ROOT/.python-version")
if [ "${1:-}" = mobile ] || [ "${1:-}" = all ]; then
  if ! command -v node >/dev/null 2>&1 || [ "$(node -p 'process.versions.node.split(".")[0]')" != "$NODE_LINE" ]; then
    if command -v brew >/dev/null 2>&1 && [ -x "$(brew --prefix "node@$NODE_LINE" 2>/dev/null)/bin/node" ]; then
      PATH="$(brew --prefix "node@$NODE_LINE")/bin:$PATH"
      export PATH
    fi
  fi
  if ! command -v node >/dev/null 2>&1 || [ "$(node -p 'process.versions.node.split(".")[0]')" != "$NODE_LINE" ]; then
    if [ "${1:-}" = mobile ]; then
      printf 'Mobile updates require Node %s. Install it or select it on PATH.\n' "$NODE_LINE" >&2
      exit 2
    fi
    printf 'Node %s is unavailable; backend updates will still be attempted.\n' "$NODE_LINE" >&2
  fi
fi
if [ -n "${NUTRITION_DEPS_PYTHON:-}" ]; then
  PYTHON=$NUTRITION_DEPS_PYTHON
else
  PYTHON=''
  if [ "${1:-}" != mobile ] && command -v "python$PYTHON_LINE" >/dev/null 2>&1 &&
     [ "$("python$PYTHON_LINE" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null)" = "$PYTHON_LINE" ]; then
    PYTHON="python$PYTHON_LINE"
  fi
  if [ -z "$PYTHON" ]; then
    for candidate in python3 "python$PYTHON_LINE"; do
      if command -v "$candidate" >/dev/null 2>&1 &&
         "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
        PYTHON=$candidate
        break
      fi
    done
  fi
  if [ -z "$PYTHON" ]; then
    old_ifs=$IFS
    IFS=:
    for search_dir in $PATH; do
      for candidate in "$search_dir"/python3.[0-9]*; do
        [ -x "$candidate" ] || continue
        case ${candidate##*/} in
          python3.[0-9]|python3.[0-9][0-9]) ;;
          *) continue ;;
        esac
        if "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
          PYTHON=$candidate
          break 2
        fi
      done
    done
    IFS=$old_ifs
  fi
fi
if [ -z "$PYTHON" ]; then
  printf 'Python %s is required for backend updates; Python 3.9+ is required for mobile. Set NUTRITION_DEPS_PYTHON to a compatible executable.\n' "$PYTHON_LINE" >&2
  exit 2
fi
exec "$PYTHON" "$ROOT/scripts/update_dependencies.py" "$@"
